# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development          # development | production

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local (Docker):  mongodb://localhost:27017/videotube
# Atlas:           mongodb+srv://<user>:<pass>@cluster.mongodb.net/videotube
MONGODB_URI=mongodb://localhost:27017/videotube

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: http://localhost:5173,https://vidflow.yourdomain.com
CORS_ORIGIN=http://localhost:5173

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=your_access_token_secret_here
ACCESS_TOKEN_EXPIRY=1d

REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=10d

# ── Cloudinary (media storage for videos + thumbnails + avatars) ──────────────
# Get from: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── HuggingFace (text embeddings for recommendations) ────────────────────────
# Get from: https://huggingface.co/settings/tokens
# Free tier is sufficient. Model: sentence-transformers/all-MiniLM-L6-v2
HF_API_KEY=hf_your_key_here
# Optional — override the default embedding model endpoint
# HF_EMBEDDING_MODEL=https://api-inference.huggingface.co/models/sentence-transformers/all-MiniLM-L6-v2

# ── Pinecone (vector database for semantic recommendations) ──────────────────
# Get from: https://app.pinecone.io → API Keys
# Create an index with dimension=384, metric=cosine
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=vidflow-videos

# ── Elasticsearch (full-text search + autocomplete) ──────────────────────────
# Local (Docker): http://localhost:9200
# Cloud:          https://<deployment>.es.io:443
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_VIDEO_INDEX=videos
# Only needed for secured/cloud ES deployments:
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=your_password
# ELASTICSEARCH_TLS_SKIP_VERIFY=false
